<odoo>
    <record id="view_contractor_worker_tree" model="ir.ui.view">
        <field name="name">contractor.worker.tree</field>
        <field name="model">contractor.worker</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="role_type"/>
                <field name="default_daily_wage"/>
                <field name="phone"/>
                <field name="project_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_contractor_worker_form" model="ir.ui.view">
        <field name="name">contractor.worker.form</field>
        <field name="model">contractor.worker</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="partner_id"/>
                        <field name="role_type"/>
                        <field name="default_daily_wage"/>
                        <field name="phone"/>
                        <field name="project_id"/>
                        <field name="active"/>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_contractor_worker" model="ir.actions.act_window">
        <field name="name">Workers</field>
        <field name="res_model">contractor.worker</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_contractor_wage_recap_tree" model="ir.ui.view">
        <field name="name">contractor.wage.recap.tree</field>
        <field name="model">contractor.wage.recap</field>
        <field name="arch" type="xml">
            <list decoration-success="payment_status == 'paid'" decoration-warning="payment_status == 'unpaid'">
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="project_id"/>
                <field name="worker_id"/>
                <field name="role_type"/>
                <field name="daily_wage"/>
                <field name="work_days"/>
                <field name="total_wage"/>
                <field name="payment_status"/>
                <field name="payment_date"/>
            </list>
        </field>
    </record>

    <record id="view_contractor_wage_recap_form" model="ir.ui.view">
        <field name="name">contractor.wage.recap.form</field>
        <field name="model">contractor.wage.recap</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="period_start"/>
                            <field name="period_end"/>
                            <field name="worker_id"/>
                            <field name="role_type" readonly="1"/>
                        </group>
                        <group>
                            <field name="daily_wage"/>
                            <field name="work_days"/>
                            <field name="total_wage" readonly="1"/>
                            <field name="payment_method"/>
                            <field name="payment_status"/>
                            <field name="payment_date"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_contractor_wage_recap" model="ir.actions.act_window">
        <field name="name">Wage Recaps</field>
        <field name="res_model">contractor.wage.recap</field>
        <field name="view_mode">list,form,pivot,graph</field>
    </record>

    <record id="view_contractor_material_purchase_tree" model="ir.ui.view">
        <field name="name">contractor.material.purchase.tree</field>
        <field name="model">contractor.material.purchase</field>
        <field name="arch" type="xml">
            <list>
                <field name="purchase_date"/>
                <field name="project_id"/>
                <field name="supplier_id"/>
                <field name="name"/>
                <field name="quantity"/>
                <field name="unit"/>
                <field name="unit_price"/>
                <field name="total_price"/>
                <field name="payment_status"/>
            </list>
        </field>
    </record>

    <record id="view_contractor_material_purchase_form" model="ir.ui.view">
        <field name="name">contractor.material.purchase.form</field>
        <field name="model">contractor.material.purchase</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="purchase_date"/>
                            <field name="project_id"/>
                            <field name="supplier_id"/>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="quantity"/>
                            <field name="unit"/>
                            <field name="unit_price"/>
                            <field name="total_price" readonly="1"/>
                            <field name="payment_status"/>
                            <field name="receipt_reference"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_contractor_material_purchase" model="ir.actions.act_window">
        <field name="name">Material Purchases</field>
        <field name="res_model">contractor.material.purchase</field>
        <field name="view_mode">list,form,pivot,graph</field>
    </record>

    <menuitem id="menu_contractor_root" name="Contractor ERP" sequence="10"/>
    <menuitem id="menu_contractor_worker" name="Workers" parent="menu_contractor_root" action="action_contractor_worker" sequence="10"/>
    <menuitem id="menu_contractor_wage_recap" name="Wage Recaps" parent="menu_contractor_root" action="action_contractor_wage_recap" sequence="20"/>
    <menuitem id="menu_contractor_material_purchase" name="Material Purchases" parent="menu_contractor_root" action="action_contractor_material_purchase" sequence="30"/>
</odoo>
