# ConstructFlow ERP — Environment Template
# Copy this file to .env and fill in every value before starting.
DOMAIN=constructflow-erp.your-domain.tld
ODOO_IMAGE=odoo:17.0
POSTGRES_IMAGE=postgres:15
POSTGRES_DB=postgres
POSTGRES_USER=odoo
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
ODOO_MASTER_PASSWORD=CHANGE_ME_STRONG_ODOO_MASTER_PASSWORD
ODOO_DB_NAME=constructflow_erp
TZ=Asia/Jakarta
